# Port for running the web server
PORT=3000

# MongoDB Connection String:
# Option 1: Local MongoDB (default)
MONGODB_URI=mongodb://127.0.0.1:27017/digital_contact_manager

# Option 2: Free MongoDB Atlas Cloud Database (uncomment & replace credentials if using cloud)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/digital_contact_manager?retryWrites=true&w=majority
